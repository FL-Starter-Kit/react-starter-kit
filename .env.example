# ------------------------------------------------------------------
# Environment configuration
#
# Frontend environment variables are NOT secrets — anything shipped
# to the browser can be inspected by users. See docs/SECURITY.md.
#
# Variables are validated at startup by src/app/config/env.ts.
# Copy this file to .env.local (or .env) and adjust as needed.
# ------------------------------------------------------------------

# Base URL of the backend API. Must be reachable from the browser.
# Leave empty to proxy API calls through the Vite dev server
# (see the `server.proxy` block in vite.config.ts).
VITE_API_BASE_URL=

# Enable the MSW mock server in the browser (dev only).
# Set to "true" to develop against mocked APIs instead of the real backend.
VITE_ENABLE_MOCKS=false

# Log level for the console logger: debug | info | warn | error | silent
VITE_LOG_LEVEL=debug

# The application name used for document titles and branding.
VITE_APP_NAME=Enterprise Starter

# Public URL the app is deployed at (used for canonical URLs and CSP).
# Example: https://example.com
VITE_PUBLIC_URL=
